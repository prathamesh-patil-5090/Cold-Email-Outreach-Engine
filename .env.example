# Path to the Google Cloud service-account JSON key (download steps in README).
# Share the spreadsheet with the service account email (client_email in that JSON) as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Postgres mirror of Outreach Tracker rows + send events.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional overrides. Defaults live in config/settings.yaml.
# SPREADSHEET_ID=1E-A_q42Jjd3S57UliOArAwABhfDOxJJBoJP3SxaNfrc
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587

# Shared Zoho web login password for all 7 outreach mailboxes.
# Used only by scripts/fetch_zoho_app_passwords.py (not for SMTP).
ZOHO_LOGIN_PASSWORD=
ZOHO_ACCOUNTS_HOST=accounts.zoho.in

# Zoho app passwords, one per outreach mailbox. Never the reply inbox.
# Fill by hand, or run: python scripts/fetch_zoho_app_passwords.py
ZOHO_APP_PASSWORD_PRATZ_P_PATIL=
ZOHO_APP_PASSWORD_PRATZ_PRATHAMESH_P=
ZOHO_APP_PASSWORD_PP_PRATHAMESH=
ZOHO_APP_PASSWORD_PP_PATIL=
ZOHO_APP_PASSWORD_PP_PRATHAMESH_PATIL=
ZOHO_APP_PASSWORD_PP_CONNECT=
ZOHO_APP_PASSWORD_PP_P_PATIL=
